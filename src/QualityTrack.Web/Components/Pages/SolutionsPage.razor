@page "/"
@inject DashboardService Dashboard
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>Soluciones · QualityTrack</PageTitle>

<div class="page-head">
    <h1>Soluciones</h1>
</div>

@if (_solutions.Count == 0)
{
    <section class="card">
        <h2>Aún no hay corridas</h2>
        <p>Crea una <a href="/settings/api-keys">clave API</a> y reporta la primera corrida de tu aplicación.</p>
        <IngestGuide />
    </section>
}
else
{
    <div class="solution-grid">
        @foreach (var solution in _solutions)
        {
            <a class="card link-card" href="@($"/solutions/{solution.Key}")">
                <div class="link-card-head">
                    <h2>@solution.Name</h2>
                    <span class="muted">@solution.RunCount @(solution.RunCount == 1 ? "corrida" : "corridas")</span>
                </div>

                @if (solution.LastRun is { } run)
                {
                    <p class="run-line">
                        <span class="chip">@run.Branch</span>
                        <span class="muted" title="@Format.Date(run.ExecutedAt)">@Format.Ago(run.ExecutedAt, _now)</span>
                    </p>
                }

                @if (solution.Progress is { } progress)
                {
                    <div class="progress-row">
                        <span class="progress-figure">@Format.Percent(progress)</span>
                        <span class="muted">de avance hacia las metas</span>
                        @if (solution.PreviousProgress is { } previous)
                        {
                            <span class="delta @DeltaClass(progress - previous)">@Format.Points(progress - previous)</span>
                        }
                    </div>
                    <ProgressBar Value="progress" Met="progress >= 1" Label="Avance hacia las metas" />
                }

                @foreach (var project in solution.Projects)
                {
                    <dl class="highlights">
                        <dt>@project.Name</dt>
                        @foreach (var metric in project.Metrics)
                        {
                            <dd>
                                <span class="muted">@metric.Metric.Name</span>
                                <strong>@Format.Value(metric.Metric, metric.Current)</strong>
                                @if (metric.Delta is not null and not 0)
                                {
                                    <DeltaBadge Comparison="metric" />
                                }
                            </dd>
                        }
                    </dl>
                }
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<SolutionSummary> _solutions = [];
    private DateTime _now;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _now = Clock.GetUtcNow().UtcDateTime;
        _solutions = await Dashboard.GetOverviewAsync(HttpContext.User.OrganizationId());

        // With a single solution there is nothing to choose: its dashboard is the start screen.
        if (_solutions is [{ RunCount: > 0 } only])
            Navigation.NavigateTo($"/solutions/{only.Key}");
    }

    private static string DeltaClass(double delta) => delta switch
    {
        > 0 => "delta-good",
        < 0 => "delta-bad",
        _ => "delta-flat"
    };
}
