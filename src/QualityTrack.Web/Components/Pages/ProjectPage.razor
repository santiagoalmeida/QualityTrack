@page "/solutions/{Key}/projects/{ProjectKey}"
@inject DashboardService Dashboard

<PageTitle>@(_project?.Name ?? "Proyecto") · @(_dashboard?.Name ?? "Solución") · QualityTrack</PageTitle>

@if (_dashboard is null || _project is null || _dashboard.Run is not { } run)
{
    <div class="empty">
        <h1>Proyecto no encontrado</h1>
        <p class="muted">No existe en la solución o no reportó nada en esta corrida.</p>
        <a class="btn btn-primary" href="@(_dashboard is null ? "/" : $"/solutions/{_dashboard.Key}")">Volver</a>
    </div>
}
else
{
    <div class="page-head">
        <div>
            <p class="crumb"><a href="/">Soluciones</a> / <a href="@SolutionUrl">@_dashboard.Name</a> /</p>
            <h1>@_project.Name</h1>
        </div>
        <a class="btn" href="@($"/solutions/{_dashboard.Key}/goals")">Metas</a>
    </div>

    <p class="run-line">
        <span class="chip">@run.Branch</span>
        <span class="muted">@Format.Date(run.ExecutedAt) · <code>@Format.ShortCommit(run.CommitSha)</code></span>
        @if (_dashboard.PreviousRun is { } previous)
        {
            <span class="muted">· comparada con <code>@Format.ShortCommit(previous.CommitSha)</code></span>
        }
    </p>

    @foreach (var category in MetricCatalog.Categories)
    {
        var metrics = _project.Metrics.Where(m => m.Metric.Category == category).ToList();
        var trends = _trends.Where(t => t.Metric.Category == category).ToList();
        var goals = metrics.Where(m => m.Goal is not null).Select(m => m.Goal!.Progress).ToList();
        @if (metrics.Count > 0)
        {
            <section class="card">
                <div class="section-head">
                    <h2>@Format.Category(category)</h2>
                    @if (goals.Count > 0)
                    {
                        <div class="section-progress">
                            <span class="muted">@Format.Percent(goals.Average()) de avance hacia sus metas</span>
                            <ProgressBar Value="goals.Average()" Met="goals.Average() >= 1" Label="@($"Avance en {Format.Category(category)}")" />
                        </div>
                    }
                </div>

                <MetricsTable Metrics="metrics" LinkFor="FindingsUrl" />

                @if (trends.Count > 0)
                {
                    <div class="chart-grid-layout section-charts">
                        @foreach (var series in trends)
                        {
                            <TrendChart Series="series" />
                        }
                    </div>
                }
            </section>
        }
    }
}

@code {
    private SolutionDashboard? _dashboard;
    private ProjectComparison? _project;
    private IReadOnlyList<TrendSeries> _trends = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string Key { get; set; } = "";

    [Parameter]
    public string ProjectKey { get; set; } = "";

    [SupplyParameterFromQuery]
    private string? Branch { get; set; }

    [SupplyParameterFromQuery]
    private Guid? Run { get; set; }

    private string SolutionUrl =>
        $"/solutions/{_dashboard!.Key}?branch={Uri.EscapeDataString(_dashboard.Branch!)}&run={_dashboard.Run!.Id}";

    // Only the latest run of a branch keeps its findings, so only its counts lead somewhere.
    private string? FindingsUrl(MetricComparison metric) =>
        metric.HasFindings
            ? $"/solutions/{_dashboard!.Key}/projects/{ProjectKey}/findings/{metric.Metric.Key}?branch={Uri.EscapeDataString(_dashboard.Branch!)}&run={_dashboard.Run!.Id}"
            : null;

    protected override async Task OnParametersSetAsync()
    {
        _dashboard = await Dashboard.GetSolutionAsync(HttpContext.User.OrganizationId(), Key, Branch, Run);
        _project = _dashboard?.Projects.FirstOrDefault(p => p.Key == ProjectKey);
        if (_project is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        _trends = _dashboard!.Trends.Where(t => t.ProjectKey == ProjectKey).ToList();
    }
}
